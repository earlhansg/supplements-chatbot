APP_NAME="Supplements Store Chatbot"

# Hosted OpenAI — used by app/llm.py. Can be left empty if you only ever use
# the local server (app/llm_local.py).
OPENAI_API_KEY=your_openai_api_key
CHAT_MODEL=gpt-4o-mini

# Local OpenAI-compatible server — used by app/llm_local.py. No real
# credentials needed; the server accepts any api_key. Check GET /v1/models on
# the server for the model IDs it accepts (unknown IDs return 404).
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=unused
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_CHAT_MODEL=sonnet
# Local, open-source sentence-transformers model (downloaded once from
# Hugging Face on first run, then cached and run fully offline).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

REDIS_URL=redis://127.0.0.1:6379

# Similarity above which a semantic cache lookup counts as a HIT (0-1, cosine similarity).
# Calibrated for BAAI/bge-base-en-v1.5's similarity distribution (paraphrases
# typically score 0.75-0.98, unrelated questions 0.50-0.65, with a contested
# band around 0.75-0.82 where weakly-worded paraphrases and topically-related
# but distinct questions overlap). If you swap in a different embedding
# model, re-check this value — similarity distributions vary by model.
CACHE_SIMILARITY_THRESHOLD=0.78
# How long cached answers live in Redis before they expire
CACHE_TTL_SECONDS=86400

# How many FAQ entries to pull from the knowledge base per question
KB_RETRIEVAL_K=3
