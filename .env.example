APP_NAME="Supplements Store Chatbot"

# Which LLM backend app/llm_factory.py resolves generate_answer from:
#   local   app/llm_local.py, an OpenAI-compatible server on LOCAL_LLM_BASE_URL
#   openai  app/llm.py, the hosted OpenAI API
# Any other value raises at import rather than quietly falling back — a typo
# here would otherwise change which LLM you are billing for without saying so.
# This replaces what used to be a commented-out import in app/workflow.py.
LLM_BACKEND=local

# Hosted OpenAI — used by app/llm.py when LLM_BACKEND=openai. Can be left empty
# if you only ever use the local server.
OPENAI_API_KEY=your_openai_api_key
CHAT_MODEL=gpt-4o-mini

# Local OpenAI-compatible server — used by app/llm_local.py. No real
# credentials needed; the server accepts any api_key. Check GET /v1/models on
# the server for the model IDs it accepts (unknown IDs return 404).
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=unused
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_CHAT_MODEL=sonnet
# Local, open-source sentence-transformers model (downloaded once from
# Hugging Face on first run, then cached and run fully offline).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

REDIS_URL=redis://127.0.0.1:6379

# The LOWER BOUND OF THE GREY BAND (0-1, cosine similarity). Its value has not
# changed but its MEANING has: it is no longer a simple hit line. Below it a
# lookup is a miss, as before; at or above it the match is a *candidate*, and
# between here and CACHE_HIT_THRESHOLD_HIGH it must still survive the anchor
# check below before it is served.
#
# Calibrated for BAAI/bge-base-en-v1.5's similarity distribution (paraphrases
# typically score 0.75-0.98, unrelated questions 0.50-0.65, with a contested
# band around 0.75-0.82 where weakly-worded paraphrases and topically-related
# but distinct questions overlap). If you swap in a different embedding
# model, re-check this value — similarity distributions vary by model.
CACHE_SIMILARITY_THRESHOLD=0.78
# How long cached answers live in Redis before they expire
CACHE_TTL_SECONDS=86400

# ---- Grey-band verification (app/semantic_cache.py) ----
# Similarity at or above which a match is confident enough to serve untouched —
# no anchor lookup is issued at all, so the fast path stays fast. Raise it to
# verify more matches (slower hits, fewer wrong answers), lower it to verify
# fewer. Embedding-model-dependent for the same reason as
# CACHE_SIMILARITY_THRESHOLD; never copy this number across a model swap.
CACHE_HIT_THRESHOLD_HIGH=0.90
# Master kill switch for the grey band's anchor check. false restores the
# pre-verification behaviour exactly: every match at or above
# CACHE_SIMILARITY_THRESHOLD is served. The `cache_band` response field stays
# populated either way, so the wire shape never varies with the flag.
CACHE_VERIFY_GREY_BAND=true
# How far the top idx:kb FAQ must beat its runner-up before the anchor is
# allowed to veto a match. Below this gap the top-1 choice is a coin flip
# between two near-duplicate FAQs, and an undecided anchor must not reject a
# match that already cleared CACHE_SIMILARITY_THRESHOLD.
#
# Measured: `python scripts/eval_threshold.py` over data/eval_pairs.json (23
# labelled pairs). Sweeping this value holds F1 flat at 0.880 across the whole
# band 0.03-0.10, so 0.05 was TESTED AND KEPT rather than merely inherited — it
# sits in the middle of the widest optimum, not on an edge. Either side is
# measurably worse on this corpus: at <=0.02 recall falls 0.846 -> 0.769, and at
# >=0.15 the 0.809 shipping false hit is served again and the false-hit rate
# doubles to 0.200.
#
# Raise it to trust the anchor less (more matches served unverified), lower it
# to trust it more (more matches rejected on a narrow anchor win). Corpus- AND
# model-dependent: re-run that sweep after editing data/faqs.json or swapping
# the embedding model.
CACHE_ANCHOR_MARGIN_MIN=0.05

# How many FAQ entries to pull from the knowledge base per question
KB_RETRIEVAL_K=3

# ---- Semantic input guardrail (app/guardrails.py) ----
# Master kill switch. false restores the pre-guardrail behaviour exactly.
GUARDRAIL_ENABLED=true
# Similarity above which the nearest BLOCK exemplar wins and the question is
# refused (0-1, cosine similarity).
#
# Measured: `python scripts/eval_guardrail.py` over data/guardrail_eval.json
# (24 held-out questions, no text shared with the exemplars) picks 0.55 as the
# F1-maximising block threshold among those that actually bind. The 0.72 this
# replaced sat above the similarity of 9 of the 12 questions that should have
# been blocked — F1 0.400 vs 0.870, recall 0.250 vs 0.833. The cost is one false
# block out of 12 allow questions, a false-block rate of 0.083 up from 0.000.
#
# n=24, so one question is worth ~4% of the set: calibration on this corpus, not
# a production-grade number. Like CACHE_SIMILARITY_THRESHOLD it is
# embedding-model-dependent — bge's similarities run lower than OpenAI's — so
# re-run that sweep rather than carrying this value across a model swap. Raise
# it to block less (more unsafe questions get through), lower it to block more
# (more legitimate product questions get refused).
GUARDRAIL_THRESHOLD=0.55

# ---- Output guardrail (the gate on the cache WRITE, not on the response) ----
# Answers shorter than this are served to the user but never cached — at this
# length an answer is almost certainly truncated or a one-line dodge.
MIN_CACHEABLE_ANSWER_CHARS=40
# Floor on the best idx:kb similarity for an answer to count as grounded in the
# knowledge base. Below it the LLM improvised past the FAQs, so the answer is
# served but not enshrined for CACHE_TTL_SECONDS. Also model-dependent.
KB_GROUNDING_FLOOR=0.50
# Longest accepted question. Long enough for a real support question, short
# enough that a pasted document cannot drive an expensive embed + LLM call.
# Mirrored at the Next.js boundary (frontend/.env.example) so the user sees a
# 400 at the edge rather than a 422 from FastAPI.
MAX_QUESTION_CHARS=500

# ---- Fixed-window rate limiting (app/rate_limit.py) ----
# Bounds LLM spend: every cache miss is a multi-second generation. Every
# request arrives from the Next.js proxy, so this limit is effectively global
# rather than per-user — see the module docstring.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Cache metrics (app/metrics.py) ----
# How long the per-day counter keys (cache:stats:<YYYY-MM-DD>:hits|misses)
# live. They EXPIRE themselves on their first increment of the day, so the
# keyspace never needs a sweep job. 30 days is long enough to show a month of
# usage in a demo and short enough that the keyspace cannot grow without bound.
# The global counters (cache:stats:hits|misses|blocked) carry no TTL at all —
# they are the lifetime totals GET /stats reports.
#
# The date boundary is UTC, not server-local: "today" must mean the same thing
# to the API and to anyone reading cache:stats:* keys from another timezone.
# On a machine well behind UTC the dashboard's "today" therefore rolls over
# early — an acceptable trade for a local demo, stated rather than hidden.
STATS_DAILY_TTL_SECONDS=2592000
