# Copy to .env.local. None of these are NEXT_PUBLIC_ — the browser only ever
# talks to this app's own /api routes, never to FastAPI or Redis directly.

# The uvicorn host running `app.main:app` in the Python project.
BACKEND_URL=http://127.0.0.1:8000

# Same Redis the backend uses. Read-only here: FT.SEARCH over idx:cache + TTL.
REDIS_URL=redis://127.0.0.1:6379

# Keep in sync with the backend's .env. Cache documents carry no timestamp, so
# an entry's age is derived as (CACHE_TTL_SECONDS - remaining TTL).
CACHE_TTL_SECONDS=86400

# Display only — shown in the cache panel header as the hit threshold.
CACHE_SIMILARITY_THRESHOLD=0.78

# Max entries listed in the left panel.
CACHE_LIST_LIMIT=100

# Ceiling for a /chat request. A cache miss calls the local LLM, whose own
# timeout (LOCAL_LLM_TIMEOUT_SECONDS) defaults to 120s.
CHAT_TIMEOUT_MS=150000
